@model API_CLIENT.Models.SignupViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API CLIENT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0b0c10;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
        }
        
        .logo-text {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            letter-spacing: 1px;
        }
        
        .auth-container {
            background-color: #0b0c10; /* Match background for seamless look as per second image */
            width: 100%;
            max-width: 450px;
            position: relative;
        }
        
        .auth-header h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .auth-header p {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
        }
        
        .auth-header .highlight {
            color: #ef4444; /* red-500 */
        }

        .form-box {
            border: 2px solid #0ea5e9; /* Light blue border around form */
            padding: 0;
            border-radius: 4px;
            margin-bottom: 1.5rem;
            overflow: hidden;
            background-color: #0b0c10;
        }

        .form-group {
            position: relative;
            padding: 0.5rem 1rem;
            border-bottom: 1px solid #1f2937;
        }
        
        .form-group:last-child {
            border-bottom: none;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: #e2e8f0;
            display: block;
        }

        .form-control {
            background-color: #2a303c;
            border: none;
            color: #94a3b8;
            padding: 0.75rem 1rem;
            width: 100%;
            border-radius: 4px;
        }
        
        .form-control:focus {
            background-color: #2a303c;
            color: #f8fafc;
            box-shadow: none;
            outline: none;
        }
        
        .form-control::placeholder {
            color: #64748b;
        }

        .btn-primary {
            background-color: #ef4444;
            border-color: #ef4444;
            padding: 0.75rem;
            font-weight: 500;
            font-size: 1.125rem;
            transition: all 0.2s;
            /* Subtle glow */
            box-shadow: 0 4px 14px 0 rgba(239, 68, 68, 0.39);
        }
        
        .btn-primary:hover, .btn-primary:focus {
            background-color: #dc2626;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }
        
        .btn-google {
            background-color: #2a303c;
            color: #e2e8f0;
            border: 1px solid #374151;
            font-size: 0.875rem;
            font-weight: 500;
            padding: 0.6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: background-color 0.2s;
            border-radius: 4px;
        }
        
        .btn-google:hover {
            background-color: #374151;
            color: #ffffff;
        }
        
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #94a3b8;
            font-size: 0.875rem;
        }
        
        .login-link {
            font-size: 0.875rem;
            color: #94a3b8;
            text-align: center;
            margin-top: 1.5rem;
        }
        
        .login-link a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 500;
        }
        
        .login-link a:hover {
            text-decoration: underline;
        }
        
        .password-container {
            position: relative;
        }
        
        .toggle-password {
            position: absolute;
            right: 25px;
            top: 65%;
            transform: translateY(-50%);
            color: #f8fafc;
            cursor: pointer;
            z-index: 10;
        }
        
        .text-danger {
            font-size: 0.8rem;
            margin-top: 0.25rem;
            display: block;
            padding: 0 1rem;
        }
        
        .validation-summary-errors {
             color: #ef4444;
             margin-bottom: 1rem;
             text-align: center;
        }
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
        }
    </style>
</head>
<body>

    <div class="logo-text">YOUR API's</div>

    <div class="auth-container">
        <div class="auth-header text-center">
            <h2>Create your account</h2>
            <p><span class="highlight">Join us</span> and start building today</p>
        </div>

        <form asp-action="Signup" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            
            <div class="form-box">
                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="JohnDoe@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <!-- Username -->
                <div class="form-group">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" placeholder="JohnDoejjc1" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                
                <!-- Password -->
                <div class="form-group password-container">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Must be 8 character long" />
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill toggle-password" viewBox="0 0 16 16" id="togglePasswordBtn1">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                    </svg>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                
                <!-- Confirm Password -->
                <div class="form-group password-container">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordInput" placeholder="Must match the password" />
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill toggle-password" viewBox="0 0 16 16" id="togglePasswordBtn2">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                    </svg>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Sign up</button>
        </form>

        <div class="divider">or</div>

        <form asp-action="ExternalLogin" method="post" class="w-100">
            <button type="submit" class="btn btn-google w-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                  <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                </svg>
                <span class="ms-1" style="color: #4285F4; font-size: 0.8rem">G</span><span style="color: #EA4335; font-size: 0.8rem">o</span><span style="color: #FBBC05; font-size: 0.8rem">o</span><span style="color: #4285F4; font-size: 0.8rem">g</span><span style="color: #34A853; font-size: 0.8rem">l</span><span style="color: #EA4335; font-size: 0.8rem">e</span>
                <span class="text-secondary ms-1" style="font-size: 0.8rem">Or sign in with Google</span>
            </button>
        </form>

        <div class="login-link">
            Already have an account? <a asp-action="Login">Sign in</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script>
        document.getElementById('togglePasswordBtn1').addEventListener('click', function() {
            var passwordInput = document.getElementById('passwordInput');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
            } else {
                passwordInput.type = 'password';
            }
        });
        document.getElementById('togglePasswordBtn2').addEventListener('click', function() {
            var passwordInput = document.getElementById('confirmPasswordInput');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
            } else {
                passwordInput.type = 'password';
            }
        });
    </script>
</body>
</html>
