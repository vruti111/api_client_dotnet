@model API_CLIENT.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API CLIENT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0b0c10;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        .logo-text {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 2rem;
            letter-spacing: 1px;
        }
        
        .auth-container {
            background-color: #121418;
            border-radius: 8px;
            padding: 2.5rem 3rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
        }
        
        /* Subtle red glow effect behind the card */
        .auth-container::before {
            content: '';
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(0,0,0,0));
            z-index: -1;
            border-radius: 10px;
        }

        .auth-header h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .auth-header p {
            font-size: 1.25rem;
            margin-bottom: 2rem;
        }
        
        .auth-header .highlight {
            color: #ef4444; /* red-500 */
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: #e2e8f0;
        }

        .form-control {
            background-color: #2a303c;
            border: 1px solid #374151;
            color: #f8fafc;
            padding: 0.75rem 1rem;
            transition: border-color 0.2s;
        }
        
        .form-control:focus {
            background-color: #2a303c;
            border-color: #64748b;
            color: #f8fafc;
            box-shadow: none;
        }
        
        .form-control::placeholder {
            color: #64748b;
        }

        .btn-primary {
            background-color: #ef4444;
            border-color: #ef4444;
            padding: 0.75rem;
            font-weight: 500;
            font-size: 1.125rem;
            transition: all 0.2s;
            /* Subtle glow */
            box-shadow: 0 4px 14px 0 rgba(239, 68, 68, 0.39);
        }
        
        .btn-primary:hover, .btn-primary:focus {
            background-color: #dc2626;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }
        
        .btn-google {
            background-color: #2a303c;
            color: #e2e8f0;
            border: 1px solid #374151;
            font-size: 0.875rem;
            font-weight: 500;
            padding: 0.6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: background-color 0.2s;
        }
        
        .btn-google:hover {
            background-color: #374151;
            color: #ffffff;
        }
        
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #94a3b8;
            font-size: 0.875rem;
        }
        
        .forgot-password {
            font-size: 0.75rem;
            color: #3b82f6;
            text-decoration: none;
            display: inline-block;
            margin-top: 0.25rem;
            float: right;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }
        
        .signup-link {
            font-size: 0.875rem;
            color: #94a3b8;
            text-align: center;
            margin-top: 1.5rem;
        }
        
        .signup-link a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 500;
        }
        
        .signup-link a:hover {
            text-decoration: underline;
        }
        
        .password-container {
            position: relative;
        }
        
        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            cursor: pointer;
        }
        
        .text-danger {
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }
    </style>
</head>
<body>

    <div class="logo-text">YOUR API's</div>

    <div class="auth-container">
        <div class="auth-header text-center">
            <h2>Welcome back 👋</h2>
            <p>Sign <span class="highlight">in to continue</span></p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="john@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="password-container">
                    <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Must be 8 character long" />
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill toggle-password" viewBox="0 0 16 16" id="togglePasswordBtn">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                    </svg>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
                <a href="#" class="forgot-password">Forgot password?</a>
                <div class="clearfix"></div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Sign in</button>
        </form>

        <div class="divider">or</div>

        <form asp-action="ExternalLogin" method="post" class="w-100">
            <button type="submit" class="btn btn-google w-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                  <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                </svg>
                <span class="ms-1" style="color: #4285F4">G</span><span style="color: #EA4335">o</span><span style="color: #FBBC05">o</span><span style="color: #4285F4">g</span><span style="color: #34A853">l</span><span style="color: #EA4335">e</span>
                <span class="text-secondary ms-1">Or sign in with Google</span>
            </button>
        </form>

        <div class="signup-link">
            Don't have an account? <a asp-action="Signup">Sign up now</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script>
        document.getElementById('togglePasswordBtn').addEventListener('click', function() {
            var passwordInput = document.getElementById('passwordInput');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
            } else {
                passwordInput.type = 'password';
            }
        });
    </script>
</body>
</html>
