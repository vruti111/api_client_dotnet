@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - API client</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0b0c10;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .navbar {
            background-color: transparent;
            padding: 1.5rem 0;
        }
        
        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff !important;
            letter-spacing: 1px;
        }
        
        .nav-link {
            color: #e2e8f0 !important;
            font-weight: 500;
            margin: 0 0.5rem;
            transition: color 0.2s;
        }
        
        .nav-link:hover {
            color: #ef4444 !important;
        }
        
        .btn-outline-light {
            border-color: #374151;
            color: #e2e8f0;
            font-weight: 500;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
        }
        
        .btn-outline-light:hover {
            background-color: #1f2937;
            border-color: #4b5563;
        }
        
        .btn-primary {
            background-color: #ef4444;
            border-color: #ef4444;
            color: #ffffff;
            font-weight: 500;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            box-shadow: 0 4px 14px 0 rgba(239, 68, 68, 0.39);
        }
        
        .btn-primary:hover {
            background-color: #dc2626;
            border-color: #dc2626;
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }

        /* Hero Section */
        .hero {
            flex: 1;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        /* Subtle background glow */
        .hero::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80vw;
            height: 80vw;
            background: radial-gradient(circle, rgba(239, 68, 68, 0.08) 0%, rgba(0,0,0,0) 70%);
            z-index: -1;
            pointer-events: none;
        }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            background: linear-gradient(to right, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .hero-title span {
            color: #ef4444;
            -webkit-text-fill-color: #ef4444;
            background: none;
        }

        .hero-subtitle {
            font-size: 1.25rem;
            color: #94a3b8;
            margin-bottom: 2.5rem;
            max-width: 600px;
            line-height: 1.6;
        }

        .btn-hero {
            padding: 1rem 2rem;
            font-size: 1.125rem;
            font-weight: 600;
            border-radius: 8px;
        }
        
        .btn-hero-secondary {
            background-color: #1f2937;
            border: 1px solid #374151;
            color: #ffffff;
            padding: 1rem 2rem;
            font-size: 1.125rem;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s;
        }
        
        .btn-hero-secondary:hover {
            background-color: #2a303c;
            color: #ffffff;
        }
        
        /* Interactive Mockup */
        .mockup-container {
            background-color: #121418;
            border-radius: 12px;
            border: 1px solid #1f2937;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            transform: perspective(1000px) rotateY(-5deg) rotateX(5deg);
            transition: transform 0.5s ease;
        }
        
        .mockup-container:hover {
            transform: perspective(1000px) rotateY(0) rotateX(0);
        }
        
        .mockup-header {
            background-color: #1a1d24;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #1f2937;
            display: flex;
            align-items: center;
        }
        
        .mockup-dots {
            display: flex;
            gap: 6px;
        }
        
        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        
        .dot-red { background-color: #ef4444; }
        .dot-yellow { background-color: #fbd38d; }
        .dot-green { background-color: #34d399; }
        
        .mockup-body {
            padding: 1.5rem;
            font-family: monospace;
            color: #a78bfa;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        
        .token-method { color: #f59e0b; font-weight: bold; }
        .token-url { color: #34d399; }
        .token-string { color: #60a5fa; }
        .token-key { color: #e879f9; }

        @@media (max-width: 991px) {
            .hero-title {
                font-size: 3rem;
            }
            .mockup-container {
                margin-top: 3rem;
                transform: none;
            }
            .mockup-container:hover {
                transform: none;
            }
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">YOUR API's</a>
            <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#documentation">Documentation</a>
                    </li>
                </ul>
                <div class="d-flex gap-3">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light">Log in</a>
                    <a asp-controller="Auth" asp-action="Signup" class="btn btn-primary">Sign up</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero pb-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <h1 class="hero-title">
                        Build, Test, and <br/>
                        Scale your <span>APIs.</span>
                    </h1>
                    <p class="hero-subtitle">
                        A powerful, dark-themed API client designed for developers. Send requests, inspect responses, and manage your API environments seamlessly.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Auth" asp-action="Signup" class="btn btn-primary btn-hero">Get Started for Free</a>
                        <a href="#documentation" class="btn btn-hero-secondary">View Documentation</a>
                    </div>
                </div>
                
                <div class="col-lg-6">
                    <div class="mockup-container">
                        <div class="mockup-header">
                            <div class="mockup-dots">
                                <div class="dot dot-red"></div>
                                <div class="dot dot-yellow"></div>
                                <div class="dot dot-green"></div>
                            </div>
                        </div>
                        <div class="mockup-body">
<pre class="m-0">
<span class="token-method">POST</span> <span class="token-url">https://api.example.com/v1/users</span>
<span class="text-secondary">Headers:</span>
  <span class="token-key">Content-Type</span>: <span class="token-string">application/json</span>
  <span class="token-key">Authorization</span>: <span class="token-string">Bearer eyJhbGciOi...</span>

<span class="text-secondary">Body:</span>
{
  <span class="token-key">"name"</span>: <span class="token-string">"Jane Doe"</span>,
  <span class="token-key">"email"</span>: <span class="token-string">"jane@example.com"</span>,
  <span class="token-key">"role"</span>: <span class="token-string">"developer"</span>
}

<span class="text-secondary">Response (201 Created):</span>
{
  <span class="token-key">"id"</span>: <span class="token-string">"usr_9f8e7d"</span>,
  <span class="token-key">"status"</span>: <span class="token-string">"success"</span>
}
</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>
